# Keep Python checkouts consistent with Ruff on every platform.
*.py text eol=lf
*.pyi text eol=lf

# cmd.exe mis-parses labels and blocks in LF-only batch files.
*.cmd text eol=crlf

# Preserve recorded checksums for generated numerical figures on Windows.
docs/frontpage/*.svg text eol=lf
docs/frontpage/*.json text eol=lf
